# Add these active-strategy settings to the existing local .env.
# Live orders remain controlled by the existing DRY_RUN=false switch and CLOB
# credentials; this file intentionally contains no secrets.

TAIL_ROUNDS=1000000
TAIL_START_MODE=next
TAIL_QTY=5.0
TAIL_DECISION_LEAD_S=10.25
TAIL_DECISION_GRACE_S=0.75
TAIL_MIN_LEADER_BID=0.90
TAIL_MAX_PM_QUOTE_AGE_S=2.0
TAIL_MAX_BINANCE_TRADE_AGE_S=2.0
TAIL_WEAK_CANDLE_MAX_BP=5.0
TAIL_WEAK_ADVERSE_CAP_BP=2.0

TAIL_PRICE_CAP=0.99
TAIL_EXEC_SLIPPAGE_TICKS=1
TAIL_MIN_VISIBLE_ASK_QTY=5.0
TAIL_MIN_NET_WIN_PER_SHARE=0.001
# Keep at 0 until the account's actual effective rebate is verified.
TAIL_TAKER_REBATE_RATE=0.0
TAIL_MAX_ENTRIES_PER_ROUND=6
# 0 means no portfolio-wide cap. Set this explicitly for a live risk limit.
TAIL_MAX_COST_PER_ROUND_USD=0.0
TAIL_USER_WS_ENABLED=false
TAIL_USER_WS_CONFIRM_TIMEOUT_S=8.0
TAIL_PM_RESOLUTION_POLL_S=15.0
