# cor_pol: BTC/ETH correlation arb bot (5-minute Polymarket markets)
#
# DRY_RUN=true discovers PM markets, subscribes to the CLOB book, simulates
# fills against the live book, and tracks PnL via PM/UMA Gamma API.
# DRY_RUN=false sends live CLOB orders using py-clob-client-v2.

# --- Mode ---
DRY_RUN=true

# --- Live CLOB execution (required only when DRY_RUN=false) ---
# CLOB_FUNDER_ADDRESS is the account that actually funds CLOB orders.
# Old API/proxy users: CLOB_SIGNATURE_TYPE=POLY_PROXY and funder=proxy wallet.
# Old Safe users: CLOB_SIGNATURE_TYPE=2 and funder=Safe/proxy wallet.
# EOA users: CLOB_SIGNATURE_TYPE=EOA and funder=the EOA address.
# Deposit-wallet users: CLOB_SIGNATURE_TYPE=POLY_1271 and funder=deposit wallet.
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
CLOB_SIGNATURE_TYPE=POLY_PROXY
CLOB_FUNDER_ADDRESS=
POLY_BUILDER_CODE=

# BUY FAK/FOK orders are dollar-amount market orders on Polymarket. The bot
# therefore forces live BUYs through a marketable GTC share-limit order and
# immediately cancels the remainder, so CORR_COMBO_QTY remains shares.
CORR_EXEC_ORDER_TYPE=GTC
CORR_EXEC_SLIPPAGE_TICKS=2
CORR_EXEC_CHASE_SLIPPAGE_TICKS=1
CORR_EXEC_MAX_CHASE_ATTEMPTS=2
CORR_EXEC_RECONCILE_TIMEOUT_S=6.0
CORR_EXEC_RECONCILE_POLL_S=0.25
# Live fill reconciliation uses CLOB submit/cancel/get_order as the execution
# source of truth. PM's authenticated user websocket is optional telemetry only.
# Keep it off for live stability unless you specifically want extra diagnostics.
CORR_USER_WS_ENABLED=false
CORR_USER_WS_CONFIRM_TIMEOUT_S=8.0
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
# Emergency flatten uses this full worst-price ceiling from the first attempt.
# It still executes at the best available prices, up to this limit.
CORR_EXEC_FLATTEN_SLIPPAGE_TICKS=24
CORR_EXEC_FLATTEN_MAX_ATTEMPTS=3
CORR_EXEC_KILL_RETRY_COOLDOWN_S=1.0
CORR_LEG_MISMATCH_TOLERANCE_SHARES=1.0

# --- Telegram notifications (optional but recommended for long dry-runs) ---
# Leave blank to disable Telegram entirely; events still print to stdout.
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Runtime ---
CORR_ROUNDS=1000000
CORR_START_MODE=next

# --- Strategy: market-discovery gates ---
CORR_MIN_CORRELATION=0.65
CORR_MIN_GAP=0.04
CORR_MAX_GAP=0.22
CORR_MIN_BOOK_SIZE=5.0
CORR_TTE_MIN_S=60
CORR_TTE_MAX_S=210
CORR_MIN_VOL_BP_60S=0.0

# --- Strategy: UTC+8 time gates ---
# Weekend rest: UTC+8 Saturday 05:00 through Monday 05:00.
CORR_WEEKEND_REST_ENABLED=true
# US stock regular-hours filter in UTC+8: Mon-Fri 21:30 through next-day 04:00.
# During this window, at least one combo leg must be at or above this price.
CORR_US_STOCK_HOURS_FILTER_ENABLED=true
CORR_US_STOCK_HOURS_MIN_LEG_PRICE=0.70

# --- Strategy: fee-adjusted EV + four-quadrant tail gate ---
# Raw edge is fair_a + fair_b - entry cost, per one-share combo.
CORR_MIN_MODEL_EDGE=0.05
# Polymarket crypto taker fee: shares * rate * price * (1-price).
CORR_TAKER_FEE_RATE=0.07
# Expected account-level cashback/credit. This is configurable and is not the
# official maker rebate; set it to the rate actually received by this account.
CORR_TAKER_REBATE_RATE=0.30
# Per-share reserve for ordinary slippage and model error.
CORR_ENTRY_EDGE_RESERVE=0.01
# net edge = raw edge - expected fee after rebate - execution reserve.
CORR_MIN_NET_MODEL_EDGE=0.02
# Keep the original broad tail diagnostics; they use an uncalibrated model.
CORR_MAX_BAD_QUAD_PROB=0.22
CORR_MAX_BAD_TO_NORMAL_RATIO=0.38

# --- Strategy: sizing ---
# Entry-only caps. Q4 stop-loss / imbalance hedge reverse buys bypass these
# caps so defensive exits cannot be blocked by entry sizing limits.
CORR_COMBO_QTY=5.0
CORR_MAX_COMBOS_PER_ROUND=3
CORR_MAX_COST_PER_ROUND_USD=15.0
CORR_COMBO_COOLDOWN_S=15.0

# --- Finalized entry filter ---
# Asymmetric-mid: at entry, one leg's PM-implied price must be >= ASYM_MID_HI
# and the other <= ASYM_MID_LO. Both legs near 0.50 = coin-flip = Q4-prone, skip.
CORR_ENTRY_ASYM_MID_HI=0.60
CORR_ENTRY_ASYM_MID_LO=0.40
# Minimum favorable bp: at entry, neither leg may already be more than this
# many bp adverse vs its strike. Negative = adverse. Default -4.0 bp.
CORR_ENTRY_MIN_FAV_BP=-4.0

# --- Final fourth-quadrant kill ---
# Executable loss uses 1 - opposite_ask. Kill when one leg's executable loss
# exceeds DEAD_LOSS_GAP_MULT * entry_gap, the other leg is also below entry, and
# both legs' fav_bp have worsened versus entry by Q4_FAV_WORSEN_BP.
CORR_Q4_DEAD_LOSS_GAP_MULT=2.0
CORR_Q4_CONFIRM_LOSS=0.0
CORR_Q4_FAV_WORSEN_BP=1.0

# --- PM/UMA resolution polling ---
CORR_PM_RESOLUTION_WAIT_S=1200.0
CORR_PM_RESOLUTION_POLL_S=15.0
CORR_PM_RESOLUTION_RETRY_S=60.0
