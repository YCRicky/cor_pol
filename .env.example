# Copy to .env and fill secrets locally. Never commit .env.

# Shadow mode creates no signed/sent order. It nevertheless starts both public
# streams so coverage and timing failures are observable before live use.
AFTERTAKE_DRY_RUN=true

# Production strategy: one causal decision 10 seconds before the close of a
# Gamma-declared 30-second TWAP market. The six-asset universe is explicit;
# HYPE is intentionally excluded until it has its own validated rule.
AFTERTAKE_STRATEGY=twap_tail_v2
AFTERTAKE_ASSETS=BTC,ETH,SOL,XRP,BNB,DOGE
AFTERTAKE_QTY=5
AFTERTAKE_OUT_DIR=out
AFTERTAKE_ORDER_TYPE=GTC

# CLOB leader + Binance USD-M Futures causal price-path filters. Binance is not the PM
# settlement source. Any stale/incomplete stream or weak-candle reversal is a
# no-trade, never a fallback to the old close+0.5-second rule.
AFTERTAKE_TAIL_DECISION_LEAD_S=10.0
AFTERTAKE_TAIL_MAX_DECISION_LATENESS_S=1.0
AFTERTAKE_TAIL_LEADER_BID_THRESHOLD=0.90
AFTERTAKE_TAIL_PM_QUOTE_MAX_AGE_S=2.0
AFTERTAKE_TAIL_LIMIT_PRICE=0.99
AFTERTAKE_TAIL_MIN_NET_WIN_PER_SHARE=0.001

# Existing execution risk controls.
AFTERTAKE_MAX_DAILY_LOSS=25
AFTERTAKE_MAX_OPEN_POSITIONS=3
AFTERTAKE_MAX_CONSECUTIVE_LOSSES=5
AFTERTAKE_MIN_SECONDS_BETWEEN_ENTRIES=60
AFTERTAKE_LIVE_MAX_ACCOUNT_RISK_FRACTION=0.50
AFTERTAKE_LIVE_QTY_FLOOR_STEP=1

# Official Polymarket CLOB V2 account fields. They are not needed in shadow
# mode; deployment validation uses them only when AFTERTAKE_DRY_RUN=false.
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
FUNDER_ADDRESS=
SIGNATURE_TYPE="2"
POLY_BUILDER_CODE=

TG_BOT_TOKEN=
TG_CHAT_ID=
