# cor_pol: EMPJP BTC 5-minute Polymarket bot
#
# DRY_RUN=true discovers the live BTC 5m market, subscribes to the CLOB book,
# simulates aggressive share-sized BUYs, and tracks PnL via PM/UMA Gamma API.
# DRY_RUN=false sends live CLOB orders using py-clob-client-v2.

# --- Mode ---
DRY_RUN=true

# --- Live CLOB execution (required only when DRY_RUN=false) ---
# CLOB_FUNDER_ADDRESS is the account that actually funds CLOB orders.
# Old API/proxy users: CLOB_SIGNATURE_TYPE=POLY_PROXY and funder=proxy wallet.
# Old Safe users: CLOB_SIGNATURE_TYPE=2 and funder=Safe/proxy wallet.
# EOA users: CLOB_SIGNATURE_TYPE=EOA and funder=the EOA address.
# Deposit-wallet users: CLOB_SIGNATURE_TYPE=POLY_1271 and funder=deposit wallet.
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
CLOB_SIGNATURE_TYPE=POLY_PROXY
CLOB_FUNDER_ADDRESS=
POLY_BUILDER_CODE=

# BUY FAK/FOK orders are dollar-amount market orders on Polymarket. The bot
# therefore forces live BUYs through a marketable GTC share-limit order and
# immediately cancels the remainder, so EMPJP_QTY remains shares.
CORR_EXEC_ORDER_TYPE=GTC
EMPJP_EXEC_SLIPPAGE_TICKS=2
EMPJP_EXEC_CHASE_SLIPPAGE_TICKS=1
EMPJP_EXEC_MAX_CHASE_ATTEMPTS=2
CORR_EXEC_RECONCILE_TIMEOUT_S=6.0
CORR_EXEC_RECONCILE_POLL_S=0.25
EMPJP_LEG_MISMATCH_TOLERANCE_SHARES=0.5
EMPJP_USER_WS_ENABLED=false
EMPJP_USER_WS_CONFIRM_TIMEOUT_S=8.0
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# --- Telegram notifications (optional but recommended) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Runtime ---
EMPJP_ROUNDS=1000000
EMPJP_START_MODE=next
EMPJP_CALIBRATION_PATH=data/empjp_e75_n30_c1_l1_calibration.json

# --- Strategy: empjp_e75_n30_c1_l1 ---
EMPJP_QTY=5.0
EMPJP_EDGE_MIN=0.075
EMPJP_MIN_CELL_N=30
EMPJP_CONFIRM_S=1
EMPJP_LATENCY_S=1
EMPJP_MIN_ENTRY_ELAPSED_S=45.0
EMPJP_MAX_ENTRY_ELAPSED_S=255.0
EMPJP_MIN_TTE_S=45.0
EMPJP_MAX_TTE_S=240.0
EMPJP_MIN_ASK=0.18
EMPJP_MAX_ASK=0.82
EMPJP_MAX_SPREAD=0.05
EMPJP_MIN_DEPTH=5.0

# Backtest showed weekends remained profitable but lower quality; default keeps
# weekends ON. Set true only if you explicitly want weekday-only trading.
EMPJP_WEEKEND_REST_ENABLED=false

# --- PM/UMA resolution polling ---
EMPJP_PM_RESOLUTION_WAIT_S=1200.0
EMPJP_PM_RESOLUTION_POLL_S=15.0
EMPJP_PM_RESOLUTION_RETRY_S=60.0
