# Copy to .env and fill secrets locally.  Never commit .env.

# First-device deployment stays in shadow mode: no order is signed or sent.
AFTERTAKE_DRY_RUN=true

# Aftertake's only strategy inputs.
AFTERTAKE_ASSET=BTC
AFTERTAKE_QTY=5
AFTERTAKE_OUT_DIR=out

# Existing execution risk controls.
AFTERTAKE_MAX_DAILY_LOSS=25
AFTERTAKE_MAX_OPEN_POSITIONS=1
AFTERTAKE_MAX_CONSECUTIVE_LOSSES=5
AFTERTAKE_MIN_SECONDS_BETWEEN_ENTRIES=60

# Live-only sizing.  A live entry uses the smaller of this risk budget and the
# current CLOB allowance, then floors to whole shares.  Fees are included.
AFTERTAKE_LIVE_MAX_ACCOUNT_RISK_FRACTION=0.50
AFTERTAKE_LIVE_QTY_FLOOR_STEP=1

# Official Polymarket CLOB V2 account fields.  They are not needed to shadow
# trade, but the deployment check will validate them when DRY_RUN=false.
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
FUNDER_ADDRESS=
SIGNATURE_TYPE="2"
POLY_BUILDER_CODE=

# Required for deployment verification and lifecycle messages.
TG_BOT_TOKEN=
TG_CHAT_ID=
