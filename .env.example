# Copy to .env and fill secrets locally. Never commit .env.

# Runtime mode. Set false only when the account fields below are configured.
MISPRICE_DRY_RUN=true

# BTC 5-minute market source settings.
MISPRICE_ASSET=BTC
MISPRICE_BINANCE_SYMBOL=BTCUSDT
MISPRICE_QTY=5

# Misprice v3 repricing-lag thesis controls.
# Strategy identity: Misprice v3 lag detector.
# Historical dataset names such as four_quadrant_v3 are telemetry sources only.
MISPRICE_MIN_ENTRY_ASK=0.35
MISPRICE_MAX_ENTRY_ASK=0.65
MISPRICE_MIN_TRANSITION_BP=3.0
MISPRICE_MAX_PRE_ABS_BP=2.5
MISPRICE_MIN_ABS_BP=3.5
MISPRICE_REPRICE_PER_BP=0.04
MISPRICE_MIN_LAG_DEPTH=0.035
MISPRICE_MIN_ELAPSED_S=20
MISPRICE_MAX_ELAPSED_S=220
# Disabled by default for v3; lag depth is the primary model, not a stopgap time ban.
MISPRICE_BAN_ELAPSED_START_S=-1
MISPRICE_BAN_ELAPSED_END_S=-1

MISPRICE_LOOP_INTERVAL_S=1
MISPRICE_OUT_DIR=out

# Execution risk controls.
MISPRICE_MAX_DAILY_LOSS=25
MISPRICE_MAX_OPEN_POSITIONS=1
MISPRICE_MAX_CONSECUTIVE_LOSSES=5
MISPRICE_MIN_SECONDS_BETWEEN_ENTRIES=60

# Required official CLOB V2 account fields. These names match cor_pol.
# The program fixes the official CLOB host and Polygon mainnet chain internally.
PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
CLOB_SIGNATURE_TYPE=POLY_PROXY
CLOB_FUNDER_ADDRESS=

# Optional Telegram lifecycle notifications.
TG_BOT_TOKEN=
TG_CHAT_ID=
