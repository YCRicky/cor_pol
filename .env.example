# Copy to .env and fill secrets locally.  Never commit .env.

# First-device deployment stays in shadow mode: no order is signed or sent.
AFTERTAKE_DRY_RUN=true

# Strategy selection remains backward-compatible for existing operators. The
# live entry path is the close+500ms snapshot contract; V9 remains research-only.
AFTERTAKE_STRATEGY=v8
AFTERTAKE_V9_LIVE_ENABLED=false

# Aftertake's strategy inputs. The EC2/live universe is intentionally multi-asset.
AFTERTAKE_ASSETS=BTC,ETH,XRP,HYPE,DOGE,SOL
AFTERTAKE_QTY=50
AFTERTAKE_OUT_DIR=out

# Live close+500ms entry contract: evaluate once after close, then freeze the
# higher paired best bid and immediately submit one GTC limit at .99. Do not
# use source timestamps as a freshness gate.
AFTERTAKE_POST_CLOSE_SNAPSHOT_DELAY_S=0.5
AFTERTAKE_POST_CLOSE_LEADER_BID_THRESHOLD=0.80
AFTERTAKE_POST_CLOSE_PAIRED_MAX_AGE_S=0.250
AFTERTAKE_POST_CLOSE_SNAPSHOT_MAX_LATENESS_S=0.250
AFTERTAKE_POST_CLOSE_LIMIT_PRICE=0.99

# Existing execution risk controls.
AFTERTAKE_MAX_DAILY_LOSS=25
AFTERTAKE_MAX_OPEN_POSITIONS=3
AFTERTAKE_MAX_CONSECUTIVE_LOSSES=5
AFTERTAKE_MIN_SECONDS_BETWEEN_ENTRIES=60

# Live-only sizing.  A live entry uses the smaller of this risk budget and the
# current CLOB allowance, then floors to whole shares.  Fees are included.
AFTERTAKE_LIVE_MAX_ACCOUNT_RISK_FRACTION=0.50
AFTERTAKE_LIVE_QTY_FLOOR_STEP=1

# Official Polymarket CLOB V2 account fields.  They are not needed to shadow
# trade, but the deployment check will validate them when DRY_RUN=false.
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
FUNDER_ADDRESS=
SIGNATURE_TYPE="2"
POLY_BUILDER_CODE=

# Required for deployment verification and lifecycle messages.
TG_BOT_TOKEN=
TG_CHAT_ID=
