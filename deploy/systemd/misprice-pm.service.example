[Unit]
Description=Misprice PM BTC 5m service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=misprice
Group=misprice
# Keep all mutable SQLite/lock/JSONL state out of the read-only code checkout.
# With MISPRICE_OUT_DIR=out, this resolves to /var/lib/misprice-pm/out.
WorkingDirectory=/var/lib/misprice-pm
StateDirectory=misprice-pm
EnvironmentFile=/etc/misprice-pm.env
ExecStart=/opt/misprice_pm/.venv/bin/misprice-pm --forever
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
