[Unit]
Description=Aftertake Polymarket CLOB service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aftertake
Group=aftertake
StateDirectory=aftertake
WorkingDirectory=/var/lib/aftertake
EnvironmentFile=/opt/aftertake/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/aftertake/.venv/bin/aftertake --deployment-check
ExecStart=/opt/aftertake/.venv/bin/aftertake --forever
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
