[Unit]
Description=cor_pol Misprice PM BTC 5m service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Keep mutable SQLite/lock/JSONL state out of the protected code checkout.
# MISPRICE_OUT_DIR=out therefore resolves to /var/lib/cor-pol/out.
WorkingDirectory=/var/lib/cor-pol
StateDirectory=cor-pol
# This repository's deployment contract keeps the completed environment here.
EnvironmentFile=/opt/cor_pol/.env
# Use the package module directly so this service does not depend on a legacy
# top-level main.py or on a console-script wrapper being present in the venv.
Environment=PYTHONPATH=/opt/cor_pol/src
ExecStartPre=/opt/cor_pol/.venv/bin/python -m misprice_pm.runner --deployment-check
ExecStart=/opt/cor_pol/.venv/bin/python -m misprice_pm.runner --forever
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
