<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.misprice_pm.dry_run</string>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/misprice_pm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/misprice_pm/.venv/bin/misprice-pm</string>
    <string>--forever</string>
    <string>--dry-run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MISPRICE_DRY_RUN</key>
    <string>true</string>
    <key>MISPRICE_MAX_ENTRY_ASK</key>
    <string>0.65</string>
    <key>MISPRICE_MIN_TRANSITION_BP</key>
    <string>3.0</string>
    <key>MISPRICE_MAX_PRE_ABS_BP</key>
    <string>2.5</string>
    <key>MISPRICE_MIN_ABS_BP</key>
    <string>3.5</string>
    <key>MISPRICE_REPRICE_PER_BP</key>
    <string>0.04</string>
    <key>MISPRICE_MIN_LAG_DEPTH</key>
    <string>0.035</string>
    <key>MISPRICE_MIN_ELAPSED_S</key>
    <string>20</string>
    <key>MISPRICE_MAX_ELAPSED_S</key>
    <string>220</string>
    <key>MISPRICE_BAN_ELAPSED_START_S</key>
    <string>-1</string>
    <key>MISPRICE_BAN_ELAPSED_END_S</key>
    <string>-1</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/misprice_pm/out/runner.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/misprice_pm/out/runner.launchd.err</string>
</dict>
</plist>
